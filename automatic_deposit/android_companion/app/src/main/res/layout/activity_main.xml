<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PhonePe Sync"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="No ADB. This app reads PhonePe on your phone and sends UTR details to your website."
            android:textColor="#93A4C3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Server URL"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/serverUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://gunduata.tech"
            android:inputType="textUri"
            android:textColor="#E8EEF8"
            android:textColorHint="#93A4C3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Sync token (from website)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/syncToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="paste sync token"
            android:inputType="text"
            android:textColor="#E8EEF8"
            android:textColorHint="#93A4C3" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Save settings" />

        <Button
            android:id="@+id/btnAccessibility"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enable Accessibility permission" />

        <TextView
            android:id="@+id/accessStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Accessibility: unknown"
            android:textColor="#93A4C3" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAutoWatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:checked="true"
            android:text="Auto-fetch when new deposit starts"
            android:textColor="#E8EEF8" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Keep this phone unlocked with Accessibility ON. When any player starts a deposit, the app opens PhonePe and syncs the latest transactions."
            android:textColor="#93A4C3"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Fetch from PhonePe"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLast3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Last 3" />

            <Button
                android:id="@+id/btnLast5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Last 5" />

            <Button
                android:id="@+id/btnLast10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Last 10" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Ready. Unlock PhonePe PIN if asked."
            android:textColor="#93A4C3" />

        <TextView
            android:id="@+id/resultBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text=""
            android:textColor="#2DD4A8"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
